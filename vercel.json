{
  "version": 2,
  "builds": [
    {
      "src": "api/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/wsgi.py"
    }
  ],
  "functions": {
    "api/wsgi.py": {
      "memory": 2048,
      "maxDuration": 30
    }
  },
  "env": {
    "DJANGO_SETTINGS_MODULE": "project.settings",
    "PYTHONVERSION": "3.11"
  }
}
